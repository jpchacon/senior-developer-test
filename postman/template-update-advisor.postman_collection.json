    {
      "name": "2. Domain invariants",
      "description": "Properties that must hold regardless of the seed data \u2014 including the decline rule.",
      "item": [
        {
          "name": "Invariants \u2014 properties that must hold for every row",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rows = pm.response.json();",
                  "",
                  "pm.test('An update never runs backwards', () => {",
                  "    rows.forEach(r => pm.expect(r.latestVersion, r.engagementId).to.be.above(r.currentVersion));",
                  "});",
                  "",
                  "pm.test('versionsBehind is consistent with the range it describes', () => {",
                  "    rows.forEach(r =>",
                  "        pm.expect(r.versionsBehind, r.engagementId).to.eql(r.latestVersion - r.currentVersion));",
                  "});",
                  "",
                  "// The rule most likely to be got wrong. Declining v4 defers it; it must never advance the",
                  "// version the next diff is computed from. If a decline had wrongly moved the pointer, a",
                  "// declined version would appear at or below currentVersion.",
                  "pm.test('DECLINE RULE: a declined version never becomes the current version', () => {",
                  "    rows.forEach(r => {",
                  "        r.previouslyDeclined.forEach(declined => {",
                  "            pm.expect(declined, `${r.engagementId} declined v${declined} but sits on v${r.currentVersion}`)",
                  "                .to.be.above(r.currentVersion);",
                  "            pm.expect(declined, `${r.engagementId} declined v${declined} beyond the pending range`)",
                  "                .to.be.at.most(r.latestVersion);",
                  "        });",
                  "    });",
                  "});",
                  "",
                  "pm.test('eng-1 declined v4 yet its range still starts at v3', () => {",
                  "    const eng1 = rows.find(r => r.engagementId === 'eng-1');",
                  "    pm.expect(eng1.previouslyDeclined).to.include(4);",
                  "    pm.expect(eng1.currentVersion, 'a decline is a deferral, not a skip').to.eql(3);",
                  "});",
                  "",
                  "pm.test('An engagement already on the latest version is omitted entirely', () => {",
                  "    pm.expect(rows.map(r => r.engagementId)).to.not.include('eng-3');",
                  "});",
                  "",
                  "pm.test('Anything pending carries something to read', () => {",
                  "    rows.forEach(r => {",
                  "        pm.expect(r.summaryPoints, r.engagementId).to.not.be.empty;",
                  "        pm.expect(r.summaryHeadline, r.engagementId).to.not.be.empty;",
                  "    });",
                  "});",
                  "",
                  "pm.test('Rows are scoped to the template that was asked for', () => {",
                  "    rows.forEach(r => pm.expect(r.templateId).to.eql(pm.collectionVariables.get('templateId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/firms/{{firmId}}/engagements/pending-updates?templateId={{templateId}}&latestVersion=6",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "firms",
                "{{firmId}}",
                "engagements",
                "pending-updates"
              ],
              "query": [
                {
                  "key": "templateId",
                  "value": "{{templateId}}"
                },
                {
                  "key": "latestVersion",
                  "value": "6"
                }
              ]
            },
            "description": "These assert relationships rather than fixed values, so they keep their meaning if the seed data changes. This is where the design's core rules are enforced from the outside."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Input validation",
      "description": "Every rejected input must be a 4xx. A 500 here would mean the service blames itself for the caller's mistake, and would corrupt error-rate alerting.",
      "item": [
        {
          "name": "Rejects version 0",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Uses the problem+json content type', () =>",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'));",
                  "pm.test('Is a client error, not a server fault', () => {",
                  "    pm.expect(pm.response.code, 'a rejected parameter must never surface as 5xx')",
                  "        .to.be.within(400, 499);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Explains what was wrong in the domain\\'s own words', () => {",
                  "    pm.expect(body.title).to.eql('Invalid request parameter');",
                  "    pm.expect(body.detail).to.include('must be positive');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/firms/{{firmId}}/engagements/pending-updates?templateId={{templateId}}&latestVersion=0",
              "host": [

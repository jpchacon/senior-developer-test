      "name": "1. Core workflow",
      "description": "The happy path, from an accumulated backlog down to nothing pending.",
      "item": [
        {
          "name": "Accumulated updates \u2014 engagement 3 versions behind (latest=6)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Type is JSON', () =>",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "pm.test('Responds well under a second', () => pm.expect(pm.response.responseTime).to.be.below(1000));",
                  "",
                  "const rows = pm.response.json();",
                  "pm.test('Body is an array', () => pm.expect(rows).to.be.an('array'));",
                  "",
                  "pm.test('Every row has the full contract, correctly typed', () => {",
                  "    rows.forEach(r => {",
                  "        pm.expect(r.engagementId, 'engagementId').to.be.a('string').and.not.empty;",
                  "        pm.expect(r.templateId, 'templateId').to.be.a('string').and.not.empty;",
                  "        pm.expect(r.currentVersion, 'currentVersion').to.be.a('number');",
                  "        pm.expect(r.latestVersion, 'latestVersion').to.be.a('number');",
                  "        pm.expect(r.versionsBehind, 'versionsBehind').to.be.a('number');",
                  "        pm.expect(r.previouslyDeclined, 'previouslyDeclined').to.be.an('array');",
                  "        pm.expect(r.summaryHeadline, 'summaryHeadline').to.be.a('string').and.not.empty;",
                  "        pm.expect(r.summaryPoints, 'summaryPoints').to.be.an('array');",
                  "    });",
                  "});",
                  "",
                  "pm.test('eng-1 spans the net range v3 to v6, not one step at a time', () => {",
                  "    const eng1 = rows.find(r => r.engagementId === 'eng-1');",
                  "    pm.expect(eng1, 'eng-1 missing - reseed the projection').to.exist;",
                  "    pm.expect(eng1.currentVersion).to.eql(3);",
                  "    pm.expect(eng1.latestVersion).to.eql(6);",
                  "    pm.expect(eng1.versionsBehind).to.eql(3);",
                  "});",
                  "",
                  "pm.test('A summary is present and mentions the range it covers', () => {",
                  "    const eng1 = rows.find(r => r.engagementId === 'eng-1');",
                  "    pm.expect(eng1.summaryPoints).to.not.be.empty;",
                  "    pm.expect(eng1.summaryHeadline).to.include('v3');",
                  "    pm.expect(eng1.summaryHeadline).to.include('v6');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
